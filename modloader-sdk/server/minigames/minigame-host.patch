--- /dev/null
+++ b/Minecraft.Client/MinigameTumbleSpawn.h
@@ -0,0 +1,21 @@
+#pragma once
+
+namespace minigame_tumble {
+// Select an actual generated block nearest the desired spawn. The predicate
+// checks the loaded level, so shapes with a central hole and small arenas work.
+template <typename HasBlock>
+bool nearest_support(int cx, int cz, int radius, double desired_x, double desired_z,
+                     HasBlock has_block, int &out_x, int &out_z) {
+    bool found = false; double best = 0;
+    for (int dx = -radius; dx <= radius; ++dx)
+        for (int dz = -radius; dz <= radius; ++dz) {
+            const int x = cx + dx, z = cz + dz;
+            const double sx = x + 0.5 - desired_x, sz = z + 0.5 - desired_z;
+            const double distance = sx * sx + sz * sz;
+            if ((!found || distance < best) && has_block(x, z)) {
+                found = true; best = distance; out_x = x; out_z = z;
+            }
+        }
+    return found;
+}
+}
--- /dev/null
+++ b/tools/test_minigame_tumble_spawn.cpp
@@ -0,0 +1,41 @@
+#include "../Minecraft.Client/MinigameTumbleSpawn.h"
+#include <cassert>
+#include <cmath>
+#include <initializer_list>
+#include <cstdio>
+
+static bool shape_contains(int shape, int r, int dx, int dz) {
+    const float d = std::sqrt(static_cast<float>(dx * dx + dz * dz)) / r;
+    switch (shape) {
+    case 0: return std::abs(dx) <= r * 0.8f && std::abs(dz) <= r * 0.8f;
+    case 1: return d <= 1.0f;
+    case 2: return d <= 0.55f + 0.45f * std::fabs(std::cos(2.5f * std::atan2(static_cast<float>(dz), static_cast<float>(dx))));
+    case 3: return d <= 1.0f && d >= 0.35f;
+    default: return std::abs(dx) + std::abs(dz) <= r;
+    }
+}
+
+int main() {
+    for (int radius : {4, 10, 22}) for (int shape = 0; shape < 5; ++shape) {
+        constexpr int cx = -33, cz = 47;
+        for (int i = 0; i < 16; ++i) {
+            const float a = 6.2831853f * i / 16;
+            const double target_x = cx + 0.5 + std::cos(a) * 8;
+            const double target_z = cz + 0.5 + std::sin(a) * 8;
+            auto supported = [=](int x, int z) { return shape_contains(shape, radius, x - cx, z - cz); };
+            int x = 0, z = 0;
+            assert(minigame_tumble::nearest_support(cx, cz, radius, target_x, target_z, supported, x, z));
+            assert(supported(x, z));
+            const double chosen = (x + 0.5 - target_x) * (x + 0.5 - target_x) + (z + 0.5 - target_z) * (z + 0.5 - target_z);
+            for (int dx = -radius; dx <= radius; ++dx) for (int dz = -radius; dz <= radius; ++dz) {
+                if (!supported(cx + dx, cz + dz)) continue;
+                const double ddx = cx + dx + 0.5 - target_x, ddz = cz + dz + 0.5 - target_z;
+                assert(chosen <= ddx * ddx + ddz * ddz);
+            }
+        }
+    }
+    int x = 7, z = 9;
+    assert(!minigame_tumble::nearest_support(0, 0, 4, 0, 0, [](int, int) { return false; }, x, z));
+    assert(x == 7 && z == 9);
+    std::puts("Tumble spawn support tests passed");
+}
